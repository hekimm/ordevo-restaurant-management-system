{
  "folders": [
    {
      "name": "Backend",
      "path": "backend"
    },
    {
      "name": "Web UI",
      "path": "backend/src/Ordevo.Web"
    },
    {
      "name": "Desktop WPF",
      "path": "backend/src/Ordevo.Desktop.Wpf"
    },
    {
      "name": "Mobile",
      "path": "mobile"
    },
    {
      "name": "Legacy (old version)",
      "path": "legacy"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/bin": true,
      "**/obj": true,
      "**/dist": true,
      "**/build": true,
      "**/.expo": true,
      "**/.git": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/bin": true,
      "**/obj": true,
      "**/dist": true,
      "**/build": true,
      "**/.expo": true
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[csharp]": {
      "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "ms-dotnettools.csdevkit",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "expo.vscode-expo-tools",
      "mtxr.sqltools"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "API: Run",
        "type": "shell",
        "command": "dotnet run --project src/Ordevo.Api",
        "options": {
          "cwd": "${workspaceFolder:Backend}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "isBackground": true
      },
      {
        "label": "Web UI: Run",
        "type": "shell",
        "command": "dotnet run --project .",
        "options": {
          "cwd": "${workspaceFolder:Web UI}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "isBackground": true
      },
      {
        "label": "Desktop WPF: Run",
        "type": "shell",
        "command": "dotnet run --project .",
        "options": {
          "cwd": "${workspaceFolder:Desktop WPF}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Desktop WPF: Publish EXE",
        "type": "shell",
        "command": "dotnet publish .\\Ordevo.Desktop.Wpf.csproj -p:PublishProfile=win-x64-singlefile",
        "options": {
          "cwd": "${workspaceFolder:Desktop WPF}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Database: Migrate",
        "type": "shell",
        "command": "./db-migrate.sh migrate",
        "options": {
          "cwd": "${workspaceFolder:Backend}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Mobile: Install Dependencies",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder:Mobile}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Mobile: Start",
        "type": "shell",
        "command": "npm start",
        "options": {
          "cwd": "${workspaceFolder:Mobile}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "isBackground": true
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": []
  }
}
