@using System.Security.Claims
@using Ordevo.Web.Models
@inject Ordevo.Web.Api.OrdevoApiClient OrdevoApi
@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string path) => current.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var displayName = User.FindFirstValue("name") ?? User.Identity?.Name ?? "Ordevo";
    DeveloperSettingsDto? runtimeSettings = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var settingsResult = await OrdevoApi.GetAsync<DeveloperSettingsDto>("/api/settings/runtime");
        if (settingsResult.IsSuccess)
            runtimeSettings = settingsResult.Value;
    }

    var modules = runtimeSettings?.Modules.ToDictionary(x => x.Code, x => x.IsEnabled, StringComparer.OrdinalIgnoreCase)
        ?? new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
    bool ModuleEnabled(string code) => !modules.TryGetValue(code, out var enabled) || enabled;
    var canManageSettings = User.HasClaim("perm", "settings.manage");
    var toastSuccess = TempData["ToastSuccess"] as string;
    var toastError = TempData["ToastError"] as string;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ordevo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <partial name="_OrdevoStyles" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand" asp-page="/Index" aria-label="Ordevo">
                <span class="brand-mark">O</span>
                <span>
                    <strong>Ordevo</strong>
                    <small>Restaurant OS</small>
                </span>
            </a>
            <nav class="app-nav">
                <a class="@Active("/Dashboard")" asp-page="/Dashboard"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                @if (ModuleEnabled("dineInOrders"))
                {
                    <a class="@Active("/Tables")" asp-page="/Tables/Index"><i class="bi bi-grid-3x3-gap"></i><span>Masalar</span></a>
                    <a class="@Active("/Kitchen")" asp-page="/Kitchen/Index"><i class="bi bi-fire"></i><span>Mutfak</span></a>
                }
                @if (ModuleEnabled("menuCms"))
                {
                    <a class="@Active("/Menu")" asp-page="/Menu/Index"><i class="bi bi-card-list"></i><span>Menü</span></a>
                }
                @if (ModuleEnabled("crm"))
                {
                    <a class="@Active("/Crm")" asp-page="/Crm/Index"><i class="bi bi-people"></i><span>CRM</span></a>
                }
                @if (ModuleEnabled("inventory"))
                {
                    <a class="@Active("/Inventory")" asp-page="/Inventory/Index"><i class="bi bi-box-seam"></i><span>Stok</span></a>
                }
                @if (ModuleEnabled("shift"))
                {
                    <a class="@Active("/Shift")" asp-page="/Shift/Index"><i class="bi bi-person-vcard"></i><span>Personel - Cihaz</span></a>
                }
                @if (ModuleEnabled("salesAnalysis"))
                {
                    <a class="@Active("/SalesAnalysis")" asp-page="/SalesAnalysis/Index"><i class="bi bi-bar-chart-line"></i><span>Satış Analizi</span></a>
                }
                @if (ModuleEnabled("finance"))
                {
                    <a class="@Active("/Finance")" asp-page="/Finance/Index"><i class="bi bi-graph-up-arrow"></i><span>Finans</span></a>
                }
                @if (ModuleEnabled("print"))
                {
                    <a class="@Active("/Print")" asp-page="/Print/Index"><i class="bi bi-printer"></i><span>Yazıcı</span></a>
                }
                @if (canManageSettings)
                {
                    <a class="@Active("/Settings")" asp-page="/Settings/Index"><i class="bi bi-gear"></i><span>Ayarlar</span></a>
                }
            </nav>
        </aside>
        <main class="app-main">
            <header class="topbar">
                <div>
                    <div class="page-kicker">@ViewData["Section"]</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="topbar-actions">
                    <span class="operator" data-initial="@(string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim().Substring(0, 1).ToUpperInvariant())">@displayName</span>
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Çıkış</span>
                        </button>
                    </form>
                </div>
            </header>
            <section class="content-wrap">
                @RenderBody()
            </section>
        </main>
    </div>
    @if (!string.IsNullOrWhiteSpace(toastSuccess))
    {
        <span hidden data-toast-message="@toastSuccess" data-toast-type="success"></span>
    }
    @if (!string.IsNullOrWhiteSpace(toastError))
    {
        <span hidden data-toast-message="@toastError" data-toast-type="error"></span>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ordevo.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
