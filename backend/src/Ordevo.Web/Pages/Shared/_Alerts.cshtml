@model IReadOnlyList<string>
@{
    var alerts = Model.Where(m => !string.IsNullOrWhiteSpace(m)).Distinct().ToList();
}
@if (alerts.Count > 0)
{
    <div class="alert-stack">
        @foreach (var error in alerts)
        {
            <div class="alert alert-danger py-2 mb-2" role="alert">@error</div>
            <span hidden data-toast-message="@error" data-toast-type="error"></span>
        }
    </div>
}
